{
  "info": {
    "name": "CampusVoiceBox API",
    "description": "Local testing collection for the CampusVoiceBox backend. Import into Postman and run the requests top to bottom on an EMPTY database. Set `adminEmail` and `adminPassword` to the ADMIN_EMAIL and ADMIN_PASSWORD in backend/.env - the server creates that default administrator when it starts, and signing up never makes an administrator. Logging in as it saves `adminToken`, which the Admin requests send. Registering saves the student's token into `token`, which every other request sends as `Authorization: Bearer {{token}}`. The second account registered is what the account requests act on (`userId` 3 - the administrator is account 1), and its token is kept in `token2` for the one request it makes itself - a privacy request, which the administrator then handles. `postId` 1 is the first post. Signing up needs `acceptTerms: true` and the current Terms and Privacy Policy versions (backend/src/models/policies.js); school details need `schoolConsent: true`. To try a password reset, run **Ask for a reset link**, then paste the token from the emailed link (after `#token=`; printed in the server's console when SMTP_HOST is not set) into `resetToken`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "postId",
      "value": "1"
    },
    {
      "key": "userId",
      "value": "3"
    },
    {
      "key": "token2",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    },
    {
      "key": "myRequestId",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": "admin@ollcf.edu.ph"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Log in as the default administrator",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('adminToken', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "description": "The default administrator, created by the server from ADMIN_EMAIL and ADMIN_PASSWORD (backend/src/config/defaultAdmin.js). Its token is saved as `adminToken`."
          }
        },
        {
          "name": "Register a student account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('token', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Juan Dela Cruz\",\n  \"email\": \"juan@school.edu.ph\",\n  \"password\": \"Passw0rd1\",\n  \"studentId\": \"2023-00145\",\n  \"course\": \"BS in Computer Science\",\n  \"yearLevel\": \"3rd Year\",\n  \"section\": \"A\",\n  \"schoolConsent\": true,\n  \"acceptTerms\": true,\n  \"termsVersion\": \"2026-10-14\",\n  \"privacyVersion\": \"2026-10-14\"\n}"
            }
          }
        },
        {
          "name": "Login (the account from Register)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@school.edu.ph\",\n  \"password\": \"Passw0rd1\"\n}"
            }
          }
        },
        {
          "name": "Register a second account (for the admin requests to act on)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Maria Santos\",\n  \"email\": \"maria@school.edu.ph\",\n  \"password\": \"Passw0rd1\",\n  \"studentId\": \"2024-00211\",\n  \"schoolConsent\": true,\n  \"acceptTerms\": true,\n  \"termsVersion\": \"2026-10-14\",\n  \"privacyVersion\": \"2026-10-14\"\n}"
            },
            "description": "Account 2. Its token is saved as `token2`, not `token`, so the requests below still run as the administrator; only the privacy request made as account 2 uses it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('token2', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "State - everything this account may see",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/state",
        "description": "The one request the website reads everything from. Without a token it answers what a visitor sees: the published posts only, with no author behind an anonymous one."
      }
    },
    {
      "name": "Privacy (the person's own choices and rights)",
      "description": "The Privacy & Data section of the account page, and handling privacy requests (manage_privacy).",
      "item": [
        {
          "name": "Accept the current Terms",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/account/terms",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"2026-10-14\",\n  \"keepSchoolDetails\": false\n}"
            },
            "description": "Asked of an account whose accepted Terms are older than the version it now needs (posting and voting answer 403 with mustAcceptTerms until then). Accepting a version already accepted records nothing new. keepSchoolDetails only matters for an account holding school details without consent: true keeps them, anything else removes them."
          }
        },
        {
          "name": "Allow keeping my school details",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/account/school-consent",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"granted\": true,\n  \"version\": \"2026-10-14\"\n}"
            },
            "description": "granted: false withdraws the consent and removes the school details at once."
          }
        },
        {
          "name": "Save my cookie choice",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/account/cookie-consent",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"2026-10-13\",\n  \"categories\": {\n    \"functional\": false\n  }\n}"
            },
            "description": "Only the optional categories that exist are kept, each true only when sent as true."
          }
        },
        {
          "name": "Download my data",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/account/export",
            "description": "Everything held about the signed-in account, as one JSON file. Recorded in the privacy log."
          }
        },
        {
          "name": "Make a privacy request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('myRequestId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/privacy-requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"correction\",\n  \"details\": \"My email should be juan.delacruz@school.edu.ph.\"\n}"
            },
            "description": "type: access, correction, deletion or other. correction and other need details. One open request per type."
          }
        },
        {
          "name": "Cancel my privacy request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/privacy-requests/{{myRequestId}}/cancel",
            "description": "Only your own, and only while nobody has started on it."
          }
        },
        {
          "name": "Make a privacy request (as account 2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('requestId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token2}}"
              }
            ],
            "url": "{{baseUrl}}/privacy-requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"access\",\n  \"details\": \"Please send me the staff notes on my posts.\"\n}"
            }
          }
        },
        {
          "name": "Admin: start handling a privacy request",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/privacy-requests/{{requestId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\",\n  \"response\": \"\"\n}"
            },
            "description": "Needs manage_privacy. Nobody may handle a request about their own account (400)."
          }
        },
        {
          "name": "Admin: complete a privacy request",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/privacy-requests/{{requestId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\",\n  \"response\": \"The notes were emailed to you today.\"\n}"
            },
            "description": "completed and declined need a response - the person is shown it. For a deletion request, completing deletes the account; send deletePosts: true to delete their submissions too (needs delete_users)."
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create post (a concern - pending until approved)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/posts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"concern\",\n  \"category\": \"safety\",\n  \"title\": \"Broken walkway lights\",\n  \"message\": \"The lights along the main walkway are out at night.\",\n  \"anonymous\": false,\n  \"attachments\": []\n}"
            },
            "description": "`attachments` takes up to three { name, dataUrl } - photos or PDFs as data URLs, as the posting form sends them."
          }
        }
      ]
    },
    {
      "name": "Admin (an administrator's token)",
      "item": [
        {
          "name": "Approve a post",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/posts/{{postId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}"
            },
            "description": "Also `under_review`, `in_progress` (reopen), and `rejected` - which needs a `reason` for the student. A move the review dialog would not offer answers 409."
          }
        },
        {
          "name": "Assign a post to a department",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/posts/{{postId}}/assign",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"department\": \"college-computer-studies\",\n  \"assignedTo\": \"Dean's office\"\n}"
            }
          }
        },
        {
          "name": "Resolve a post",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/posts/{{postId}}/resolve",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolution\": \"New lights were installed.\"\n}"
            }
          }
        },
        {
          "name": "Add an internal note",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/posts/{{postId}}/notes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Checked with the facilities office.\"\n}"
            }
          }
        },
        {
          "name": "Edit an account",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/users/{{userId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Maria Santos\",\n  \"email\": \"maria.santos@school.edu.ph\",\n  \"studentId\": \"2024-00211\",\n  \"course\": \"BS in Nursing\",\n  \"yearLevel\": \"1st Year\",\n  \"section\": \"C\"\n}"
            }
          }
        },
        {
          "name": "Suspend an account",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/users/{{userId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"suspended\"\n}"
            },
            "description": "Account 2. `active` reactivates it. Not allowed on your own account (400)."
          }
        },
        {
          "name": "Change an account's role",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/users/{{userId}}/role",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"user\"\n}"
            },
            "description": "admin, student or user. Not allowed on your own account (400)."
          }
        },
        {
          "name": "Delete an account",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/users/{{userId}}",
            "description": "Their posts and votes are kept. Not allowed on your own account (400)."
          }
        },
        {
          "name": "The whole activity log",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/activity-logs"
          }
        }
      ]
    },
    {
      "name": "Vote",
      "item": [
        {
          "name": "Toggle vote on a post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/posts/{{postId}}/vote",
            "description": "Only posts on the public board can be voted on - which is why this comes after Admin -> Approve."
          }
        }
      ]
    },
    {
      "name": "My account",
      "item": [
        {
          "name": "Update my details",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/account",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Juan Dela Cruz\",\n  \"studentId\": \"2023-00145\",\n  \"course\": \"BS in Computer Science\",\n  \"yearLevel\": \"4th Year\",\n  \"section\": \"A\"\n}"
            },
            "description": "Name and school details only - the email, role and status are an administrator's to change."
          }
        },
        {
          "name": "Remove my profile photo",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/account/photo",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"photo\": \"\"\n}"
            },
            "description": "An empty photo goes back to initials; a JPG, PNG or WebP data URL sets one."
          }
        },
        {
          "name": "Mark all my notifications read",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/notifications/read-all"
          }
        },
        {
          "name": "Change my password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/account/password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Passw0rd1\",\n  \"newPassword\": \"Passw0rd2\"\n}"
            },
            "description": "Signed in, with the current password. Every other device is signed out; the answer is a new token for this one, saved into `token`."
          }
        }
      ]
    },
    {
      "name": "Log out",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/auth/logout",
        "description": "Recorded in the activity log for administrators. The token itself stays valid until it expires - the website simply forgets it."
      }
    },
    {
      "name": "Forgot password (no sign-in needed)",
      "item": [
        {
          "name": "Ask for a reset link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/forgot-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@school.edu.ph\"\n}"
            },
            "description": "Answers the same whether or not the email has an account. Emails a one-time link (valid one hour) to /reset-password#token=... - without SMTP_HOST set, the email is printed in the server's console instead."
          }
        },
        {
          "name": "Set a new password with the emailed link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/reset-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"Passw0rd3\"\n}"
            },
            "description": "Paste the part of the emailed link after #token= into the `resetToken` collection variable first. Signs the account out on every device."
          }
        }
      ]
    }
  ]
}
