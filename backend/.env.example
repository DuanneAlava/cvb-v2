# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Server ---
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
# The React dev server runs on 3000 by default.
CORS_ORIGIN=http://localhost:3000

# --- Database (local Postgres via docker-compose, see docker-compose.yml) ---
PGHOST=localhost
PGPORT=5432
PGUSER=cvb_user
PGPASSWORD=cvb_password
PGDATABASE=campusvoicebox

# --- Auth ---
# Any long random string works for local development.
# Generate a real one for production with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
