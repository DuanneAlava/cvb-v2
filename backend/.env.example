# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Server ---
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
# The React dev server runs on 3000 by default.
CORS_ORIGIN=http://localhost:3000

# Set to 1 when a reverse proxy (nginx, a load balancer, a hosting platform)
# sits in front of this server, so the activity log and the rate limits see
# each visitor's own address instead of the proxy's. Leave it unset otherwise.
# TRUST_PROXY=1

# --- Database (local Postgres via docker-compose, see docker-compose.yml) ---
PGHOST=localhost
PGPORT=5432
PGUSER=cvb_user
PGPASSWORD=cvb_password
PGDATABASE=campusvoicebox

# --- Auth ---
# Any long random string works for local development. With NODE_ENV=production
# the server refuses to start unless this is at least 32 characters and not
# this example's value. Generate one with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- The default administrator ---
# Signing up on the website only makes student and user accounts. The one
# account that can open the admin panel is created from these when the server
# starts, if the database has no administrator yet. Once it exists, changing
# these does nothing - change the password from the admin's own profile in
# the admin panel, or with "Forgot password?" on the log-in page.
# Choose the password yourself, in your own .env - it is left blank here on
# purpose, so no password is ever written in the repository. It needs at
# least 8 characters, with a letter and a number; with it blank, no
# administrator is created.
ADMIN_NAME=CampusVoiceBox Admin
ADMIN_EMAIL=admin@ollcf.edu.ph
ADMIN_PASSWORD=

# --- Email: the "Forgot password?" link ---
# A forgotten password is reset with a one-time link, emailed through the
# school's own mail server (backend/src/config/mail.js). While developing,
# leave SMTP_HOST empty: the email is printed in this server's console
# instead of being sent. In production it must be set, or no reset link can
# be sent. For Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_SECURE=true, and an "app password" as SMTP_PASS - never the account's
# normal password. Like ADMIN_PASSWORD, SMTP_PASS belongs only in your own
# .env, never in the repository.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CampusVoiceBox <no-reply@ollcf.edu.ph>

# The website's address - the emailed reset link points here.
APP_URL=http://localhost:3000
