# Used only by `docker compose up` - the backend container reads this
# instead of .env. The db host is "db" (the docker-compose service name),
# not "localhost", because containers reach each other by service name.

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

PGHOST=db
PGPORT=5432
PGUSER=cvb_user
PGPASSWORD=cvb_password
PGDATABASE=campusvoicebox

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
