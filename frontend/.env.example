# Copy to .env.local to point the website at a backend API somewhere else.
# Left unset, development uses http://localhost:4000/api and a production
# build uses /api on the website's own address. It is read when the site is
# BUILT, so change it before `npm run build`, not after.
# See GUIDE.md, "How the website talks to the server".
REACT_APP_API_URL=http://localhost:4000/api
