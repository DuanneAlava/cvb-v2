# CampusVoiceBox website - production image (docker-compose.prod.yml).
#
# Stage 1 builds the site into plain HTML, CSS and JavaScript files. Stage 2
# is nginx alone - no Node at all - serving those files and passing /api on
# to the backend, so the website and the API share one address. A build
# with REACT_APP_API_URL unset calls /api on its own address, which is
# exactly that (src/services/api.js).
FROM node:24-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:stable-alpine
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY nginx/security-headers.conf /etc/nginx/security-headers.conf
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 80
