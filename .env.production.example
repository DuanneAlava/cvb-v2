# The settings for docker-compose.prod.yml. On the server, copy this file to
# .env (beside docker-compose.prod.yml - it is git-ignored) and fill it in.
# Never commit the real one. GUIDE.md, "Running it for real", explains each.

# --- Required: compose refuses to start without these ---

# The database's own password. Any long random value: openssl rand -hex 24
POSTGRES_PASSWORD=
# What makes sign-in tokens impossible to forge. At least 32 characters:
# openssl rand -hex 32
JWT_SECRET=
# The address people open the website at - reset links point here.
APP_URL=https://voicebox.example.edu.ph

# --- The default administrator (created at the first start) ---
# The password needs at least 8 characters, with a letter and a number.
ADMIN_NAME=CampusVoiceBox Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Email for "Forgot password?" ---
# Without SMTP_HOST no reset link can be sent. For Google Workspace:
# smtp.gmail.com, port 465, SMTP_SECURE=true, and an "app password".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CampusVoiceBox <no-reply@ollcf.edu.ph>

# --- Optional ---
# The port the website is published on (default 80).
# HTTP_PORT=80
# How many proxies sit in front of the backend: nginx is 1; make it 2 when
# HTTPS is handled by another proxy or the hosting platform in front of it.
# TRUST_PROXY=1
# POSTGRES_USER=cvb_user
# POSTGRES_DB=campusvoicebox
# JWT_EXPIRES_IN=7d
